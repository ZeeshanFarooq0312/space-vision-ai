# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+psycopg://visionstack:visionstack@localhost:5432/visionstack

# Optional per-camera RTSP credential overrides (referenced by camera_id from configs/cameras.yaml)
# RTSP_ENTRY_CAM_1_URI=rtsp://user:pass@192.168.1.10:554/stream1

LOG_LEVEL=INFO

# External face-embedding service used by employee onboarding until a local RetinaFace/ArcFace
# model replaces it (see README's identity/ TODOs).
FACE_API_BASE_URL=http://182.180.87.19:3009

# YOLO weights for the live-capture/video-upload pipelines. Defaults to stock COCO; point at a
# fine-tuned checkpoint (copied into ./models, which is volume-mounted into the api container)
# to use it instead -- see README's "Live camera pipeline" section.
DETECTION_WEIGHTS_PATH=models/yolov8n.pt
