# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env / secrets
.env

# Models & samples (large binaries, not committed)
models/*.pt
models/*.onnx
samples/*.mp4
samples/*.avi
samples/*.mov

# Node / frontend
frontend/node_modules/
frontend/dist/

# DB
*.sqlite3

# Processed video recordings (live-capture output, not committed)
data/processed_videos/

# Employee onboarding enrollment photos (biometric-adjacent, not committed)
data/employee_photos/

# Local faceverify service (faceverify/) writes real enrollment photos into its mounted
# src/ dir at runtime -- same biometric-data reasoning as data/employee_photos/ above.
faceverify/src/*
!faceverify/src/.gitkeep

# Raw uploaded videos, deleted after processing but ignored as a safety net
data/video_uploads/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
